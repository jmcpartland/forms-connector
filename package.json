{
  "name": "forms-connector",
  "version": "0.2.0",
  "description": "Local MCP server (Claude Desktop extension) for creating and editing Google Forms",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "bundle": "node scripts/build.mjs --bundle-only",
    "build": "npm run typecheck && npm test && node scripts/build.mjs",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmcpartland/forms-connector.git"
  },
  "bugs": {
    "url": "https://github.com/jmcpartland/forms-connector/issues"
  },
  "homepage": "https://github.com/jmcpartland/forms-connector#readme",
  "author": "Joseph McPartland"
}
